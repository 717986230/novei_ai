page {
  background: #f5f7fb;
  color: #1f2937;
  font-size: 28rpx;
}

.container {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.08);
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.sub-title {
  font-size: 24rpx;
  color: #6b7280;
}

.field {
  margin-bottom: 20rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.input,
.textarea {
  width: 100%;
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 18rpx;
  box-sizing: border-box;
}

.textarea {
  min-height: 160rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #4f46e5, #7c3aed);
  color: #fff;
  border: none;
}

.btn-secondary {
  background: #eef2ff;
  color: #4338ca;
}

.hint {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 8rpx;
}

.result-success,
.result-error {
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  margin-top: 14rpx;
  font-size: 24rpx;
}

.result-success {
  background: #dcfce7;
  color: #166534;
}

.result-error {
  background: #fee2e2;
  color: #991b1b;
}
