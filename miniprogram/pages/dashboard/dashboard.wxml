<view class="container">
  <view class="card">
    <view class="title">系统控制台</view>
    <view class="sub-title">一眼查看配置、进度与风险</view>
  </view>

  <view class="card">
    <view class="label">系统状态</view>
    <view class="hint">AI连接：{{hasAiConfig ? '已配置' : '未配置'}}</view>
    <view class="hint">小说：{{novelTitle || '未创建'}}</view>
    <view class="hint">待发布章节：{{stats.unpublished || 0}}</view>
  </view>

  <view class="card">
    <view class="label">风险告警</view>
    <block wx:if="{{alerts.length === 0}}">
      <view class="result-success">当前无告警</view>
    </block>
    <block wx:for="{{alerts}}" wx:key="*this">
      <view class="result-error" style="margin-top: 10rpx;">{{item}}</view>
    </block>
  </view>

  <view class="card">
    <view class="label">关键指标</view>
    <view class="hint">总章节：{{stats.total || 0}}</view>
    <view class="hint">已发布：{{stats.published || 0}}</view>
    <view class="hint">总字数：{{stats.totalWords || 0}}</view>
    <view class="hint">平均字数：{{stats.averageWords || 0}}</view>
  </view>

  <view class="card">
    <view class="label">快捷操作</view>
    <button class="btn-primary" bindtap="goCreate">去创作</button>
    <button class="btn-secondary" bindtap="goPublish" style="margin-top: 14rpx;">去发布</button>
    <button bindtap="goConfig" style="margin-top: 14rpx;">去设置</button>
  </view>

  <view class="card">
    <view class="label">最新章节</view>
    <block wx:if="{{latest.length === 0}}">
      <view class="hint">暂无章节</view>
    </block>
    <block wx:for="{{latest}}" wx:key="number">
      <view class="chapter-item">
        <view class="chapter-title">第{{item.number}}章 {{item.title}}</view>
        <view class="hint">{{item.wordCount || 0}} 字 | {{item.published ? '已发布' : '待发布'}}</view>
      </view>
    </block>
  </view>
</view>
