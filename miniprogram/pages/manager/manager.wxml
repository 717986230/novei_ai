<view class="container">
  <view class="card">
    <view class="title">小说管理</view>
    <view class="sub-title">创建小说、生成章节、发布章节</view>
  </view>

  <view class="card">
    <view class="field">
      <text class="label">小说标题（可空）</text>
      <input class="input" placeholder="可留空，AI自动生成" value="{{novelTitle}}" bindinput="onNovelTitleInput" />
    </view>
    <view class="field">
      <text class="label">小说类型</text>
      <input class="input" placeholder="都市 / 玄幻 / 言情..." value="{{novelType}}" bindinput="onNovelTypeInput" />
    </view>
    <view class="field">
      <text class="label">小说简介</text>
      <textarea class="textarea" placeholder="输入小说简介" value="{{novelDesc}}" bindinput="onNovelDescInput" />
    </view>
    <button class="btn-primary" loading="{{creating}}" bindtap="createNovel">创建小说</button>
  </view>

  <view class="card">
    <button class="btn-primary" loading="{{generatingOne}}" bindtap="generateChapter">生成下一章</button>
    <button class="btn-secondary" loading="{{generatingBatch}}" bindtap="generateTen" style="margin-top: 14rpx;">连续生成 10 章</button>
    <button loading="{{publishing}}" bindtap="publishChapters" style="margin-top: 14rpx;">发布待发布章节</button>
  </view>

  <view wx:if="{{resultMessage}}" class="{{resultSuccess ? 'result-success' : 'result-error'}}">
    {{resultMessage}}
  </view>

  <view class="card">
    <view class="label">统计</view>
    <view class="hint">总章节：{{stats.total}}，已发布：{{stats.published}}，总字数：{{stats.totalWords}}</view>
  </view>

  <view class="card">
    <view class="label">章节列表</view>
    <block wx:if="{{chapters.length === 0}}">
      <view class="hint">暂无章节</view>
    </block>
    <block wx:for="{{chapters}}" wx:key="number">
      <view class="chapter-item">
        <view class="chapter-title">第{{item.number}}章 {{item.title}}</view>
        <view class="hint">{{item.wordCount || 0}} 字 | {{item.published ? '已发布' : '待发布'}}</view>
      </view>
    </block>
  </view>
</view>
