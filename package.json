{
  "name": "novel-ai-global",
  "version": "2.0.0",
  "private": true,
  "description": "AI web-novel studio for overseas platforms (Stary Writing/Dreame, Webnovel, Royal Road, Wattpad). Cloudflare Workers + D1 + Gemini.",
  "type": "module",
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply novel_ai --local",
    "db:migrate:remote": "wrangler d1 migrations apply novel_ai --remote",
    "deploy": "npm run build:web && wrangler deploy",
    "typecheck": "tsc -p worker/tsconfig.json --noEmit && vue-tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.164.0"
  }
}
